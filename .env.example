# Copie ce fichier en ".env.local" et remplis les valeurs dont tu as besoin.
# .env.local n'est PAS versionné (voir .gitignore).
#
# Où les trouver : Supabase → ton projet → Settings → API
#   - Project URL          -> VITE_SUPABASE_URL
#   - Project API keys : anon / public  -> VITE_SUPABASE_ANON_KEY
#
# Sur Vercel : Settings → Environment Variables → ajoute les deux mêmes clés.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optionnel — phrase d'accès admin locale côté serveur (`woltar` par défaut).
# Ne pas préfixer avec VITE_.
WOLTAR_ADMIN_PASSPHRASE=

# --- Aether (voir docs/JOUEURS_AETHER_AUDIT.md) ------------------------------
# Clé API OpenAI (platform.openai.com → API keys). NE JAMAIS la préfixer
# "VITE_" : un préfixe VITE_ ferait passer la valeur dans le bundle envoyé au
# navigateur. Sans préfixe, elle reste lue uniquement côté serveur par
# plugins/woltar-aether.js (dev) et le Worker (production).
OPENAI_API_KEY=

# Le modèle d’Aether est fixé à gpt-5.6-luna pour correspondre à sa mention publique.
